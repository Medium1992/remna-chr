# Two permanent raw rules match these lists.  Load the smaller (normally empty)
# one, then clear the previous list only after manifest validation succeeds.
#
# Unlike the ADDRESS_LISTS loaders this script has its own scheduler, so it can
# in principle overlap that chain and fight it over the shared :global
# AddressList selector.  The schedules are set six hours apart from it, and the
# guard below yields the cycle anyway; the next one follows in six hours.
:if ([:len [/system/script/job/find where script="ADDRESS_LISTS"]] > 0) do={
    :log warning "TOR skipped: the ADDRESS_LISTS chain is running"
} else={
    :local listA "TOR_NODES"
    :local listB "TOR_NODES_NEXT"
    :local countA [:len [/ip/firewall/address-list/find where list=$listA]]
    :local countB [:len [/ip/firewall/address-list/find where list=$listB]]
    :local staging $listA
    :local previous $listB
    :if ($countA >= $countB) do={
        :set staging $listB
        :set previous $listA
    }

    :local baseUrl "{{ ip_lists_base_url }}/torv4"
    :local fetchData do={
        :local r [/tool/fetch url=$1 mode=https output=user as-value]
        :if (($r->"status") != "finished") do={ :error ("TOR fetch failed: " . $1) }
        :return ($r->"data")
    }

    # Raw GitHub manifest files end in LF/CRLF.  RouterOS :tonum does not
    # consistently trim those terminators, so retain only leading digits.
    :local manifestNumber do={
        :local text $1
        :local digits ""
        :for i from=0 to=([:len $text] - 1) do={
            :local char [:pick $text $i ($i + 1)]
            :if ([:find "0123456789" $char] != nil) do={
                :set digits ($digits . $char)
            } else={
                :break
            }
        }
        :return [:deserialize $digits from=json]
    }

    :local expectedParts [$manifestNumber [$fetchData ($baseUrl . "/tor.parts")]]
    :local expectedEntries [$manifestNumber [$fetchData ($baseUrl . "/tor.entries")]]
    :if (($expectedParts < 1) || ($expectedEntries < 1)) do={ :error "TOR manifest is invalid" }

    /ip/firewall/address-list/remove [find where list=$staging]
    :global AddressList $staging
    :for part from=1 to=$expectedParts do={
        :local content [$fetchData ($baseUrl . "/tor_part" . $part . ".rsc")]
        :local parsed [:parse $content]
        $parsed
    }

    :local loaded [:len [/ip/firewall/address-list/find where list=$staging]]
    :if ($loaded != $expectedEntries) do={ :error ("TOR count mismatch: expected=" . $expectedEntries . " loaded=" . $loaded) }

    /ip/firewall/address-list/remove [find where list=$previous]
    :log warning ("TOR refresh complete: " . $loaded . " relays in " . $staging)
}
